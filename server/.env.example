# Порт сервера (Railway автоматически устанавливает PORT)
PORT=3001

# Разрешённые CORS origins (для продакшена укажите ваш домен Vercel)
# Можно несколько через запятую: https://your-app.vercel.app,https://another-domain.com
CORS_ORIGIN=*

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Admin ID (ваш user id для получения уведомлений)
TELEGRAM_ADMIN_ID=your_admin_id_here